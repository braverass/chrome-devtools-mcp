{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "project": "chrome-devtools-mcp",
  "lastUpdated": "2025-02-08",

  "tools": {
    "navigation": {
      "navigate_page": "导航到 URL，支持 back/forward/reload",
      "list_pages": "列出所有打开的页面",
      "select_page": "选择页面作为后续操作的上下文",
      "close_page": "关闭页面",
      "new_page": "创建新页面"
    },
    "interaction": {
      "click": "点击页面元素",
      "fill": "填充表单字段",
      "fill_form": "批量填充多个表单字段",
      "hover": "悬停在元素上",
      "drag": "拖拽元素",
      "press_key": "按键或组合键",
      "upload_file": "上传文件"
    },
    "inspection": {
      "take_snapshot": "获取页面可访问性快照（推荐）",
      "take_screenshot": "截图",
      "list_console_messages": "列出控制台消息",
      "list_network_requests": "列出网络请求"
    },
    "performance": {
      "performance_start_trace": "开始性能追踪录制",
      "performance_stop_trace": "停止性能追踪",
      "performance_analyze_insight": "分析性能洞察"
    },
    "debug": {
      "evaluate_script": "执行 JavaScript",
      "emulate": "模拟设备、网络、地理位置",
      "resize_page": "调整页面大小",
      "wait_for": "等待文本出现"
    }
  },

  "endpoints": {
    "mcpServer": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "optionalArgs": [
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics"
      ]
    }
  },

  "scripts": {
    "build": "tsc && node scripts/post-build.ts",
    "typecheck": "tsc --noEmit",
    "format": "eslint --cache --fix . && prettier --write --cache .",
    "test": "npm run build && node scripts/test.mjs",
    "bundle": "npm run clean && npm run build && rollup -c rollup.config.mjs"
  },

  "dependencies": {
    "core": {
      "@modelcontextprotocol/sdk": "1.25.3",
      "puppeteer": "24.36.1",
      "debug": "4.4.3"
    },
    "dev": {
      "typescript": "5.9.2",
      "rollup": "4.57.1",
      "eslint": "9.35.0",
      "prettier": "3.6.2"
    }
  },

  "configFiles": {
    "typescript": "tsconfig.json",
    "eslint": "eslint.config.mjs",
    "prettier": ".prettierrc.cjs",
    "rollup": "rollup.config.mjs",
    "puppeteer": "puppeteer.config.cjs",
    "mcpServer": "server.json"
  },

  "patterns": {
    "async": "所有浏览器操作都是异步的，使用 async/await",
    "waitFor": "使用 Puppeteer 自动等待功能确保元素可用",
    "snapshot": "优先使用 take_snapshot 而非 screenshot 进行交互",
    "errorHandling": "捕获并提供清晰的错误消息给 MCP 客户端"
  },

  "notes": {
    "browserMode": "需要远程调试模式下运行的 Chrome (--remote-debugging-port=9222)",
    "usageStats": "默认启用遥测，使用 --no-usage-statistics 禁用",
    "license": "Apache-2.0",
    "author": "Google LLC"
  }
}
